rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
//  Stepping Stone ERP — HARDENED Firestore security rules
//  Firebase project: steppingstone-32aaf
//  Roles (authoritative source = accounts/{uid}.role): admin, office, vp,
//  teacher, parent, student, disabled.
//
//  WHAT CHANGED vs the in-app FIRESTORE_RULES template
//  ───────────────────────────────────────────────────
//  (1) studentDirectory — was readable by ANY signed-in user (full PII: Aadhaar,
//      DOB, address, phones). Now READ + WRITE are restricted to admin + office.
//      Teachers/VP read the PII-free 'academicRoster' instead (still broadly
//      readable below).
//  (2) portalFees — was readable by ANY signed-in user and keyed by a guessable
//      admission number, so any student/parent could enumerate every family's
//      balance. Now a parent/student may read ONLY the doc whose id matches their
//      own accounts/{uid}.admNo; admin + office still read/write all.
//  (3) users — was world-readable (to every signed-in user) and may still hold a
//      plaintext 'password' field. Now a user reads ONLY their own users doc;
//      admin + office may read any. NOTE: Firestore rules cannot hide a single
//      field — the 'password' field MUST be purged from every users doc, because
//      anyone allowed to read the doc reads the WHOLE doc including 'password'.
//  (4) auditLogs — NEW append-only collection. admin/office may CREATE entries;
//      NO update and NO delete from any client, so the trail is immutable.
//  (5) Self-promotion block retained on accounts (write = admin only) and on
//      users (a non-admin/office editor may not change the 'role' field).
//  (6) Final catch-all deny retained: anything not matched above is locked.
//
//  Helpers: role() reads accounts/{uid}.role; isAny(list) is true when the
//  caller is signed in AND their role is in 'list'.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    // Authoritative role lookup. Wrapped so a missing accounts doc => null role
    // (which is never 'in' any allow-list, so access is denied by default).
    function role() {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        ? get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role
        : null;
    }
    function isAny(roles) { return signedIn() && (role() in roles); }
    // Legacy VP accounts were encoded as role:'admin', fees:false. Distinguish them inside the rules as well as
    // the UI, otherwise a legacy VP inherits Director-only account-management rights from the 'admin' string.
    function isDirectorRole() {
      return role() == 'admin'
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('fees', true) != false;
    }
    function isVicePrincipalRole() {
      return role() == 'vp'
        || (role() == 'admin'
          && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('fees', true) == false);
    }
    // The caller's own admission number from their account doc (null if none).
    function myAdmNo() {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        ? get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('admNo', null)
        : null;
    }
    // Ownership key used by teacher-authored operational records. The UI validates assignments too, but rules
    // must independently prevent one teacher from editing another teacher's plan or daily log by guessing an id.
    function myUsername() {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        ? get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('username', '')
        : '';
    }
    function myAccountName() {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        ? get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('name', '')
        : '';
    }
    // The caller's own users-doc id. users docs are keyed by safeId(username) =
    // username with every non-alphanumeric char replaced by '_'. The auth token
    // carries only a synthetic email, so we read username from accounts/{uid} and
    // apply the same transform to find "their own" profile doc id.
    function myUserDocId() {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        ? get(/databases/$(database)/documents/accounts/$(request.auth.uid))
            .data.get('username', '').replace('[^a-zA-Z0-9]', '_')
        : '';
    }
    // True when id is the caller's OWN profile doc or their own prog_<username>
    // practice-progress doc — the only two users-collection ids a non-admin may touch.
    function ownsUserDoc(id) {
      return id != '' && (id == myUserDocId() || id == 'prog_' + myUserDocId());
    }
    // Class-teacher authority comes from the caller's own users profile. Coordinators deliberately span every
    // section; a regular teacher reaches only the exact Class N-section values assigned in classTeacherOf.
    function isCoordinatorRole() {
      return isAny(['teacher'])
        && exists(/databases/$(database)/documents/users/$(myUserDocId()))
        && get(/databases/$(database)/documents/users/$(myUserDocId())).data.get('coordinator', false) == true;
    }
    // users/__classTeachers holds the shared map {"Class 9-A": "<username>"} and has ALWAYS been an equal source
    // of class-teacher authority in the app: the Attendance screen offers a teacher the sections named here even
    // when their own profile carries no classTeacherOf array. Teachers assigned before Staff -> Assign began
    // mirroring that map onto each profile therefore passed the UI check and were refused by this rule, which is
    // what produced "Couldn't save attendance - Missing or insufficient permissions" on 2 September 2026.
    // Accept the same map the UI reads, matching on username or display name exactly as the UI does. This grants
    // nothing the UI did not already offer; it stops the two disagreeing.
    // A section may have SEVERAL class teachers, so a map entry is a list of usernames; entries written before
    // that change are a bare string. Accept both shapes, or a co-class-teacher is refused on save.
    function ctEntryIsMine(entry) {
      return (entry is list)
        ? entry.hasAny([myUsername(), myAccountName()])
        : (entry in [myUsername(), myAccountName()]);
    }
    // cls is stored already prefixed ("Class 10"), so the plain concatenation is the form that matches the map
    // key; the 'Class ' + cls form is kept only for older documents that stored a bare "10", exactly as
    // ownsClassSection does. Checking one form alone would silently never match.
    function ctMapSaysMine(data) {
      return exists(/databases/$(database)/documents/users/__classTeachers)
        && (ctEntryIsMine(get(/databases/$(database)/documents/users/__classTeachers).data
              .get('map', {}).get(data.get('cls','') + '-' + data.get('section',''), ''))
            || ctEntryIsMine(get(/databases/$(database)/documents/users/__classTeachers).data
              .get('map', {}).get('Class ' + data.get('cls','') + '-' + data.get('section',''), '')));
    }
    function ownsClassSection(data) {
      return isAny(['teacher'])
        && exists(/databases/$(database)/documents/users/$(myUserDocId()))
        && (get(/databases/$(database)/documents/users/$(myUserDocId())).data.get('classTeacherOf', [])
              .hasAny([data.get('cls','') + '-' + data.get('section',''), 'Class ' + data.get('cls','') + '-' + data.get('section','')])
            || ctMapSaysMine(data));
    }
    // Teaching work uses one exact class-section-subject tuple. Older profiles without teachingPairs retain
    // their legacy classes + subjects access until leadership reviews them in Staff → Assign.
    function ownsTeachingPair(data) {
      return isAny(['teacher'])
        && exists(/databases/$(database)/documents/users/$(myUserDocId()))
        && ((get(/databases/$(database)/documents/users/$(myUserDocId())).data.get('teachingPairs', []).size() > 0
              && get(/databases/$(database)/documents/users/$(myUserDocId())).data.get('teachingPairs', []).hasAny([
                'Class ' + data.get('class', data.get('cls','')) + '-' + data.get('section','') + '|' + data.get('subject', data.get('subj','')),
                data.get('class', data.get('cls','')) + '-' + data.get('section','') + '|' + data.get('subject', data.get('subj',''))
              ]))
            || (get(/databases/$(database)/documents/users/$(myUserDocId())).data.get('teachingPairs', []).size() == 0
              && get(/databases/$(database)/documents/users/$(myUserDocId())).data.get('classes', []).hasAny([
                'Class ' + data.get('class', data.get('cls','')) + '-' + data.get('section',''),
                data.get('class', data.get('cls','')) + '-' + data.get('section','')
              ])
              && get(/databases/$(database)/documents/users/$(myUserDocId())).data.get('subjects', []).hasAny([data.get('subject', data.get('subj',''))])));
    }
    // Greencity is the LIVE, UNPREFIXED branch. Its money/PII collections below check only ROLE, so without this
    // guard a signed-in OFFICE / STAFF / PARENT account belonging to ANOTHER branch would reach Greencity's money
    // and PII. The Director (admin) reaches every branch; everyone else must have 'greencity' (or 'all') in their
    // branches. Default ['greencity'] keeps every existing Greencity account (which may predate the branches field).
    function inGreencity() {
      return role() == 'admin'
        || (signedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
            && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('branches', ['greencity']).hasAny(['greencity','all']));
    }

    // ── Authoritative roles ────────────────────────────────────────────────
    // accounts/{uid}.role is the rules-authoritative role. Readable by any
    // signed-in user (the app reads its own role on login), but WRITABLE only by
    // admin — this blocks self-promotion (a teacher cannot edit their own role
    // to 'admin'), written during the one-time migration and by user management.
    match /accounts/{id} {
      // accounts holds username/role/name/email/admNo (+ a parent's child name/class). Staff need the full list;
      // a family member reads ONLY their own account doc (keyed by uid) — no cross-branch enumeration of everyone.
      allow read: if isAny(['admin','office','vp']) || (signedIn() && id == request.auth.uid);
      // Director manages all. The VP may create TEACHER logins only — never Office (money), Student (requires
      // a writable Student Record), Parent, or another privileged role; and cannot edit/disable/delete accounts.
      allow create: if isDirectorRole()
        || (isVicePrincipalRole() && request.resource.data.get('role','') == 'teacher');
      allow update, delete: if isDirectorRole();
    }

    // ── Money — Director + Office only, and only within Greencity ────────────
    // Cash ledger is tamper-EVIDENT: office may create receipts and update non-amount fields (idempotent
    // re-imports, note/mode fixes, the __structure/__waivers config docs which carry no 'amount'), but
    // CHANGING an amount or DELETING a receipt is Director-only. This closes the cashier cash-theft window.
    match /fees/{id} {
      allow read:   if isAny(['admin','office']) && inGreencity();
      allow create: if inGreencity() && (isAny(['admin'])
        || (isAny(['office']) && !id.matches('^__.*') && request.resource.data.get('disc', false) == false));
      allow update: if inGreencity() && (isAny(['admin'])
        || (isAny(['office']) && !id.matches('^__.*')
          && request.resource.data.get('amount', 0) == resource.data.get('amount', 0)));
      allow delete: if isAny(['admin']) && inGreencity();
    }

    // Cashier day-close snapshots. Office may close a day; only the Director may reopen or alter a close.
    match /feeDayCloses/{id} {
      allow read: if isAny(['admin','office']) && inGreencity();
      allow create: if isAny(['admin','office']) && inGreencity()
                    && request.resource.data.status == 'closed';
      allow update, delete: if isAny(['admin']) && inGreencity();
    }

    // Staff monthly salary (base pay per staff + payroll settings). Sensitive — Director + Office ONLY.
    // Payroll-run transitions are enforced here, not only hidden in the UI: Office may PREPARE a run and later
    // record an APPROVED run as PAID, but cannot approve, reopen or rewrite a frozen run. Director owns those steps.
    match /salaries/{id} {
      allow read: if isAny(['admin','office']) && inGreencity();
      allow create: if inGreencity() && (isAny(['admin'])
        || (isAny(['office']) && (!id.matches('^__payroll_.*')
          || request.resource.data.get('status','') == 'prepared')));
      allow update: if inGreencity() && (isAny(['admin'])
        || (isAny(['office']) && (!id.matches('^__payroll_.*')
          || (resource.data.get('status','draft') == 'draft' && request.resource.data.get('status','') == 'prepared')
          || (resource.data.get('status','') == 'approved' && request.resource.data.get('status','') == 'paid'
            && request.resource.data.get('rows',[]) == resource.data.get('rows',[])
            && request.resource.data.get('totals',{}) == resource.data.get('totals',{})
            && request.resource.data.get('calculationSignature','') == resource.data.get('calculationSignature','')))));
      allow delete: if isAny(['admin']) && inGreencity();
    }

    // Monotonic counters (e.g. counters/feeReceipts) — allocated atomically in a transaction during fee
    // collection so two simultaneous saves can't mint the same receipt number. Director + Office only.
    match /counters/{id} { allow read, write: if isAny(['admin','office']) && inGreencity(); }

    // (2) Fee summary published to the student/parent portal — portalFees/<admNo>.
    // admin/office read & write everything. A parent/student may read ONLY the
    // doc whose id equals their own accounts/{uid}.admNo (stringified), so they
    // cannot enumerate other families' balances by guessing admission numbers.
    // Parents/students never write.
    match /portalFees/{id} {
      allow read: if inGreencity() && (isAny(['admin','office'])
        || (isAny(['parent','student']) && id == string(myAdmNo())));
      allow write: if isAny(['admin','office']) && inGreencity();
    }

    // New-admission welcome slips — Director + Office only
    match /admissions/{id} { allow read, write: if isAny(['admin','office']) && inGreencity(); }

    // Discipline incidents (per-student behaviour log) — all staff read; admin/VP/teacher log them.
    // Discipline cases are evidentiary — staff create/update (incl. the {deleted:true} soft-delete flag), only the Director hard-deletes.
    match /discipline/{id} {
      allow read: if isAny(['admin','vp','office','teacher']);
      allow create: if isAny(['admin','vp','office'])
        || (isAny(['teacher']) && request.resource.data.reportedById == myUsername());
      allow update: if isAny(['admin','vp']) || isCoordinatorRole()
        || (isAny(['teacher'])
          && (resource.data.get('reportedById','') == myUsername() || resource.data.get('assignedToId','') == myUsername()
            || resource.data.get('by','') == myAccountName() || resource.data.get('assignedTo','') == myAccountName())
          && request.resource.data.get('status','open') in ['open','review','action']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actions','status','updatedAt','updatedBy','lastActionAt']))
        || (isAny(['office'])
          && request.resource.data.get('status','open') in ['open','review','action']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentNoticeId','actions','status','updatedAt','updatedBy','lastActionAt']));
      allow delete: if isAny(['admin']);
    }
    // Parent concerns / absence notes. A parent may CREATE and query only records tied to their own admission
    // number; they can never edit, resolve or delete them. Leadership owns the queue and its resolution trail.
    match /complaints/{id} {
      allow read: if isAny(['admin','vp','office'])
        || (isAny(['teacher']) && resource.data.get('category','') == 'Absence note'
          && (isCoordinatorRole() || ownsClassSection(resource.data)))
        || (isAny(['parent']) && resource.data.admNo == string(myAdmNo()));
      allow create: if isAny(['admin','vp','office'])
        || (isAny(['parent'])
          && request.resource.data.admNo == string(myAdmNo())
          && request.resource.data.status == 'open'
          && request.resource.data.source == 'parent-portal');
      allow update, delete: if isAny(['admin','vp','office']);
    }

    // Full term-exam registers contain the entire class and are STAFF ONLY. Family/student portals read the
    // per-child release snapshot below; UI filtering is never used as a privacy boundary.
    match /exams/{id} {
      allow read: if isAny(['admin','vp','office','teacher']);
      // Creating or DELETING a term exam affects every subject and every pupil in the class — a subject
      // teacher could delete an exam and take all its marks with it. Management only, matching who publishes.
      allow create, delete: if isAny(['admin','vp']);
      allow update: if isAny(['admin','vp'])
        || (isAny(['office','teacher'])
            && resource.data.get('published',false) != true
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['subjects','published','publishedAt','publishedBy','publishedRevision','unpublishedAt','name','cls','term','date'])
            && (isCoordinatorRole()
              || (request.resource.data.get('reviewStatus','needs-review') == 'needs-review'
                && request.resource.data.get('reviewedAt','') == ''
                && request.resource.data.get('reviewedBy','') == '')));
    }
    match /portalExamResults/{id} {
      allow read: if isAny(['admin','vp','office'])
        || (isAny(['parent','student']) && resource.data.admNo == string(myAdmNo()));
      allow create, update: if isAny(['admin','vp']);
      allow delete: if false;
    }

    // ── (1) Student records (FULL PII) — admin + office ONLY ──────────────────
    // studentDirectory holds Aadhaar, DOB, address, phones, parent contacts, etc.
    // Previously any signed-in user could read it. Now READ and WRITE are limited
    // to admin + office. Teachers/VP must use academicRoster (no PII) below.
    // VP / Principal may READ student records (full directory, no fees); only Director + Office can write/import.
    match /studentDirectory/{id} { allow read: if isAny(['admin','vp','office']) && inGreencity(); allow write: if isAny(['admin','office']) && inGreencity(); }

    // Academic data — any signed-in user reads; only staff write
    match /tests/{id}             { allow read: if signedIn(); allow write: if isAny(['admin','vp','teacher']); }
    match /topics/{id}            { allow read: if signedIn(); allow write: if isAny(['admin','vp','teacher']); }
    match /syllabus/{id}          { allow read: if signedIn(); allow write: if isAny(['admin','vp','teacher']); }
    // Copy checking: staff only. Deliberately NOT signedIn() on read - parents must not see which pupils'
    // copies are outstanding, so this is narrower than the syllabus rule directly above.
    match /copyChecks/{id}        { allow read, write: if isAny(['admin','vp','teacher']); }
    match /attendance/{id} {
      allow read: if signedIn();
      allow create: if isAny(['admin','vp']) || (isAny(['teacher']) && (isCoordinatorRole() || ownsClassSection(request.resource.data)));
      allow update: if isAny(['admin','vp']) || (isAny(['teacher']) && (isCoordinatorRole() || (ownsClassSection(resource.data) && ownsClassSection(request.resource.data))));
      allow delete: if isAny(['admin','vp']);
    }
    match /students/{id}          { allow read: if signedIn(); allow write: if isAny(['admin','vp','office','teacher']); }

    // Student photos — one small JPEG per admission no. All staff may upload; any signed-in user reads.
    match /studentPhotos/{id}     { allow read: if signedIn(); allow write: if isAny(['admin','vp','office','teacher']); }
    // Sign-in helper: maps a parent's mobile -> the children linked to it, so a parent with more than one child
    // can pick which child BEFORE typing that child's date of birth. Read is necessarily public (the parent is
    // not signed in yet), so each entry carries the MINIMUM to recognise a child: first name + class only —
    // no surname, no admission number, no phone, no date of birth.
    // get is allowed (you must already know the full mobile number, which is the document id) but list is
    // DENIED, so the collection cannot be enumerated to harvest families.
    match /parentLookup/{id}      { allow get: if true; allow list: if false; allow write: if isAny(['admin','vp','office']); }

    // Academic roster (admission no. + name + section + parent phone) — all staff read; Director/Office sync it.
    // Deliberately broadly readable: this is the PII-free roster teachers/VP use instead of studentDirectory.
    // Parent phone is included so class teachers can Call/WhatsApp absentees; Aadhaar/address are NOT here.
    match /academicRoster/{id}    { allow read: if signedIn(); allow write: if isAny(['admin','vp','office']); }

    // Test-name → admission-no. links for legacy marks — staff read; markers write
    match /studentLinks/{id}      { allow read: if signedIn(); allow write: if isAny(['admin','vp','office','teacher']); }

    // App config (current session etc.) — everyone signed-in reads; director/VP writes
    match /meta/{id}              { allow read: if signedIn(); allow write: if isAny(['admin','vp']); }

    // Pre-admission registration enquiries — office, VP & admin
    match /registrations/{id}     { allow read, write: if isAny(['admin','vp','office']) && inGreencity(); }

    // Online UPI payment claims: a signed-in parent submits their own (create only, can't read others);
    // office/admin read the queue and confirm/reject. A claim is just a CLAIM — no money moves until the
    // office verifies the credit and records the receipt, so a spoofed admNo achieves nothing.
    match /paymentIntents/{id} {
      allow read:           if isAny(['admin','office']) && inGreencity();
      allow create:         if signedIn() && inGreencity()
                              && request.resource.data.status == 'pending'
                              && request.resource.data.admNo is string
                              && request.resource.data.amount is number && request.resource.data.amount > 0
                              && (isAny(['admin','office']) || request.resource.data.admNo == string(myAdmNo()));
      allow update, delete: if isAny(['admin','office']) && inGreencity();
    }

    match /timetables/{id}        { allow read: if signedIn(); allow write: if isAny(['admin','vp']); }
    match /timetableSettings/{id} { allow read: if signedIn(); allow write: if isAny(['admin','vp']); }
    match /notices/{id} {
      allow read: if signedIn();
      allow create, delete: if isAny(['admin','vp','office']);
      // Staff post/edit/delete; TEACHERS/PARENTS/STUDENTS may only acknowledge — an update touching nothing but readBy/ackAt.
      allow update: if isAny(['admin','vp','office'])
        || (isAny(['teacher','office','parent','student']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','ackAt']));
    }
    match /calendar/{id}          { allow read: if signedIn(); allow write: if isAny(['admin','vp']); }
    match /lessonPlans/{id} {
      allow read: if signedIn();
      allow create: if isAny(['admin','vp']) || (isAny(['teacher']) && request.resource.data.teacherId == myUsername() && ownsTeachingPair(request.resource.data));
      allow update: if isAny(['admin','vp']) || (isAny(['teacher']) && resource.data.teacherId == myUsername() && request.resource.data.teacherId == myUsername() && ownsTeachingPair(request.resource.data));
      allow delete: if isAny(['admin','vp']) || (isAny(['teacher']) && resource.data.teacherId == myUsername());
    }
    match /teacherLogs/{id} {
      allow read: if signedIn();
      allow create: if isAny(['admin','vp']) || (isAny(['teacher']) && request.resource.data.teacherId == myUsername() && (request.resource.data.get('isSubstitute',false) == true || ownsTeachingPair(request.resource.data)));
      allow update: if isAny(['admin','vp']) || (isAny(['teacher']) && resource.data.teacherId == myUsername() && request.resource.data.teacherId == myUsername() && (request.resource.data.get('isSubstitute',false) == true || ownsTeachingPair(request.resource.data)));
      allow delete: if isAny(['admin','vp']) || (isAny(['teacher']) && resource.data.teacherId == myUsername());
    }
    match /leaves/{id} {
      allow read: if signedIn();
      allow create: if isAny(['admin','vp']) || (isAny(['teacher']) && request.resource.data.teacherId == myUsername() && request.resource.data.status == 'pending');
      allow update: if isAny(['admin','vp']) || (isAny(['teacher'])
        && resource.data.teacherId == myUsername() && request.resource.data.teacherId == myUsername()
        && (resource.data.status in ['pending','approved']) && request.resource.data.status == 'withdrawn'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','withdrawnAt']));
      allow delete: if isAny(['admin','vp']);
    }
    match /conceptNotes/{id}      { allow read: if signedIn(); allow write: if isAny(['admin','vp','teacher']); }
    // Staff attendance. A SELF check-in must carry serverAt == request.time (the real server clock), so a teacher
    // can't forge an on-time mark by changing their phone — even by hand. Office/director/biometric writes are exempt.
    match /staffAttendance/{id}   { allow read: if signedIn(); allow write: if isAny(['admin','vp','teacher','office']) && (!('source' in request.resource.data) || request.resource.data.source != 'self' || request.resource.data.serverAt == request.time); }

    // Practice mistakes — students log their own; staff manage
    match /wrongAnswers/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAny(['admin','vp','teacher']);
    }

    // Login history — staff read; any signed-in user adds their own entry
    match /loginLogs/{id} {
      allow read: if isAny(['admin','vp']);
      allow create: if signedIn();
    }

    // ── (4) Audit log — APPEND-ONLY / IMMUTABLE ──────────────────────────────
    // admin/office may CREATE an audit entry. No update and no delete are ever
    // allowed from any client, so the trail cannot be tampered with or erased.
    // (Reads limited to admin/office; tighten further to admin-only if desired.)
    match /auditLogs/{id} {
      allow read:   if isAny(['admin','office']);
      allow create: if isAny(['admin','office']);
      allow update: if false;
      allow delete: if false;
    }

    // ── (3) Profiles — own-doc read; password field MUST be purged ────────────
    // SECURITY NOTE: Firestore rules grant access to the WHOLE document, never a
    // subset of fields. Any plaintext 'password' field still present here is
    // exposed to everyone allowed to read the doc. It MUST be purged from every
    // users doc — no rule can hide a single field.
    match /users/{id} {
      // A user reads ONLY their own profile doc. users docs are keyed by
      // safeId(username); the authoritative username for this uid lives in
      // accounts/{uid}.username, so we match the requested id against the
      // safeId-transformed username. admin/office may read any profile.
      // EXCEPTION: the two SHARED config docs (__classTeachers map + __subjects list) are
      // org-wide config, not personal data — every staff member must read them (e.g. a teacher
      // needs the class-teacher map to know which sections they mark). They're read by a TARGETED
      // single-doc get. The VP/Principal also lists the collection (the Timetable teacher picker + staff
      // oversight need the full roster), so 'vp' is included; parents/students/teachers still can't list it.
      allow read: if isAny(['admin','office','vp'])
        || ((id.matches('.*__classTeachers') || id.matches('.*__subjects')) && isAny(['admin','office','vp','teacher']))
        || (signedIn() && ownsUserDoc(id));

      // Director/Office manage all profiles & create users. VP may edit the
      // shared config docs (subjects list, class-teacher map). Everyone else may
      // write ONLY their OWN docs: their profile (create or update — e.g. the
      // one-time "add your phone" prompt) or their own prog_<username> practice
      // doc, with the role field forced to equal their real account role (blocks
      // self-promotion AND cross-user overwrites — the old "any existing doc if
      // role unchanged" clause let any session rewrite any staff profile).
      allow write: if isDirectorRole() || isAny(['office'])
        || ((id.matches('.*__subjects') || id.matches('.*__classTeachers')) && (isDirectorRole() || isVicePrincipalRole()))
        || (isVicePrincipalRole() && !id.matches('.*__subjects') && !id.matches('.*__classTeachers')
            && resource != null && resource.data.get('role','') == 'teacher'
            && request.resource.data.get('role','') == 'teacher')
        || (isVicePrincipalRole() && !id.matches('.*__subjects') && !id.matches('.*__classTeachers')
            && resource == null
            && request.resource.data.get('role','') == 'teacher')
        || (!id.matches('.*__subjects') && !id.matches('.*__classTeachers')
            && signedIn() && ownsUserDoc(id)
            && request.resource.data.get('role', role()) == role());
    }

    // ── (5b) PER-BRANCH DATA — "<branch>_<base>" collections (Phase 2, Option B) ──────────────
    // Greencity keeps the UNPREFIXED collections above (unchanged). Surajkund / Maniram / All-Girls
    // live in "<branch>_<base>" collections. A user reaches ONLY their own branch(es); the DIRECTOR
    // (accounts/{uid}.branches contains 'all') reaches every branch. Base names + branch ids have no
    // '_', so split('_')[0]=branch and [1]=base. NOTE: parent/student per-branch PORTAL self-scoping
    // (own portalFees / paymentIntents) is a later refinement — the three new branches start empty and
    // are onboarded by the director/office first; Greencity's parent rules above are unchanged.
    function myBranches() {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        ? get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('branches', ['greencity'])
        : [];
    }
    // The Director is the only 'admin' role (VP is 'vp', office is 'office'), so admin = reaches every branch.
    // (Not gated on a branches:['all'] flag — that flag may be unset on older Director accounts and would wrongly lock the Director out of the new campuses.)
    function isDirector() { return role() == 'admin'; }
    function inBranch(coll) { return isDirector() || myBranches().hasAny([coll.split('_')[0]]); }
    function baseOf(coll) { return coll.split('_').size() == 2 ? coll.split('_')[1] : ''; }

    // Money + full-PII for a branch — that branch's Director/Office only (Director reaches any branch)
    match /{bc}/{id} {
      allow read, write: if signedIn() && inBranch(bc)
        && (baseOf(bc) in ['studentDirectory','counters','portalFees','salaries','paymentIntents'])
        && isAny(['admin','office']);
    }
    // A branch's cash ledger is tamper-EVIDENT exactly like Greencity's (/fees above): office may create
    // receipts and fix non-amount fields, but CHANGING an amount or DELETING a receipt is Director-only.
    match /{bcf}/{idf} {
      allow read, create: if signedIn() && inBranch(bcf) && baseOf(bcf) == 'fees' && isAny(['admin','office']);
      allow update: if signedIn() && inBranch(bcf) && baseOf(bcf) == 'fees' && (isAny(['admin'])
        || (isAny(['office']) && request.resource.data.get('amount', 0) == resource.data.get('amount', 0)));
      allow delete: if signedIn() && inBranch(bcf) && baseOf(bcf) == 'fees' && isAny(['admin']);
    }
    // A branch parent/student reads ONLY their own portalFees doc and may file ONLY their own UPI
    // payment intent (mirrors the unprefixed Greencity rules — without this, branch parents see nothing).
    match /{bcp}/{idp} {
      allow read: if signedIn() && inBranch(bcp) && baseOf(bcp) == 'portalFees'
        && isAny(['parent','student']) && idp == string(myAdmNo());
    }
    match /{bcpi}/{idpi} {
      allow create: if signedIn() && inBranch(bcpi) && baseOf(bcpi) == 'paymentIntents'
        && isAny(['parent','student'])
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.admNo == string(myAdmNo());
    }
    // copyChecks is in __BRANCH_SCOPED, so every campus but Greencity reads/writes "<branch>_copyChecks" — a
    // name that appears in NEITHER list of the per-branch academic block above, so it falls through to the
    // catch-all deny. The screen would render, show "Copies 0/42" on every chapter, and every tick would fail.
    // Deliberately narrower than the academic block: NO signedIn()-only read, because parents must never see
    // whose copies are outstanding.
    match /{bccc}/{idccc} {
      allow read, write: if signedIn() && inBranch(bccc) && baseOf(bccc) == 'copyChecks'
        && isAny(['admin','vp','teacher']);
    }
    // A branch's VP / Principal may READ student records (no fees) — write/import stays Director + Office (above).
    match /{bcd}/{idd} {
      allow read: if signedIn() && inBranch(bcd) && baseOf(bcd) == 'studentDirectory' && isAny(['admin','vp','office']);
    }
    // Academic / operational / workflow for a branch — that branch's staff read; appropriate roles write
    match /{bc2}/{id2} {
      allow read: if signedIn() && inBranch(bc2)
        && ((baseOf(bc2) in ['students','academicRoster','tests','topics','syllabus','studentLinks','studentPhotos','timetables','timetableSettings','notices','lessonPlans','teacherLogs','leaves','wrongAnswers'])
          || ((baseOf(bc2) in ['exams','discipline','registrations','admissions']) && isAny(['admin','vp','office','teacher'])));
      allow write: if signedIn() && inBranch(bc2)
        && (baseOf(bc2) in ['students','academicRoster','exams','tests','topics','syllabus','studentLinks','studentPhotos','timetables','timetableSettings','notices','registrations','admissions'])
        && isAny(['admin','vp','office','teacher']);
    }
    // Attendance ownership and parent absence-note privacy stay identical on every campus.
    match /{bcat}/{idat} {
      allow read: if signedIn() && inBranch(bcat) && baseOf(bcat) == 'attendance';
      allow create: if signedIn() && inBranch(bcat) && baseOf(bcat) == 'attendance'
        && (isAny(['admin','vp']) || (isAny(['teacher']) && (isCoordinatorRole() || ownsClassSection(request.resource.data))));
      allow update: if signedIn() && inBranch(bcat) && baseOf(bcat) == 'attendance'
        && (isAny(['admin','vp']) || (isAny(['teacher']) && (isCoordinatorRole() || (ownsClassSection(resource.data) && ownsClassSection(request.resource.data)))));
      allow delete: if signedIn() && inBranch(bcat) && baseOf(bcat) == 'attendance' && isAny(['admin','vp']);
    }
    match /{bccp}/{idcp} {
      allow read: if signedIn() && inBranch(bccp) && baseOf(bccp) == 'complaints'
        && (isAny(['admin','vp','office'])
          || (isAny(['teacher']) && resource.data.get('category','') == 'Absence note' && (isCoordinatorRole() || ownsClassSection(resource.data)))
          || (isAny(['parent']) && resource.data.admNo == string(myAdmNo())));
      allow create: if signedIn() && inBranch(bccp) && baseOf(bccp) == 'complaints'
        && (isAny(['admin','vp','office'])
          || (isAny(['parent']) && request.resource.data.admNo == string(myAdmNo()) && request.resource.data.status == 'open' && request.resource.data.source == 'parent-portal'));
      allow update, delete: if signedIn() && inBranch(bccp) && baseOf(bccp) == 'complaints' && isAny(['admin','vp','office']);
    }
    // Branch-prefixed teacher-authored records use the same ownership boundary as Greencity above. They are
    // deliberately excluded from the broad academic write block so overlapping wildcard rules cannot reopen it.
    match /{bcta}/{idta} {
      allow create: if signedIn() && inBranch(bcta) && (baseOf(bcta) in ['lessonPlans','teacherLogs'])
        && (isAny(['admin','vp']) || (isAny(['teacher']) && request.resource.data.teacherId == myUsername()
          && ((baseOf(bcta) == 'teacherLogs' && request.resource.data.get('isSubstitute',false) == true) || ownsTeachingPair(request.resource.data))));
      allow update: if signedIn() && inBranch(bcta) && (baseOf(bcta) in ['lessonPlans','teacherLogs'])
        && (isAny(['admin','vp']) || (isAny(['teacher']) && resource.data.teacherId == myUsername() && request.resource.data.teacherId == myUsername()
          && ((baseOf(bcta) == 'teacherLogs' && request.resource.data.get('isSubstitute',false) == true) || ownsTeachingPair(request.resource.data))));
      allow delete: if signedIn() && inBranch(bcta) && (baseOf(bcta) in ['lessonPlans','teacherLogs'])
        && (isAny(['admin','vp']) || (isAny(['teacher']) && resource.data.teacherId == myUsername()));
    }
    match /{bclv}/{idlv} {
      allow create: if signedIn() && inBranch(bclv) && baseOf(bclv) == 'leaves'
        && (isAny(['admin','vp']) || (isAny(['teacher']) && request.resource.data.teacherId == myUsername() && request.resource.data.status == 'pending'));
      allow update: if signedIn() && inBranch(bclv) && baseOf(bclv) == 'leaves'
        && (isAny(['admin','vp']) || (isAny(['teacher'])
          && resource.data.teacherId == myUsername() && request.resource.data.teacherId == myUsername()
          && (resource.data.status in ['pending','approved']) && request.resource.data.status == 'withdrawn'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','withdrawnAt'])));
      allow delete: if signedIn() && inBranch(bclv) && baseOf(bclv) == 'leaves' && isAny(['admin','vp']);
    }
    // Branch discipline cases are evidentiary: staff create/update (incl. the {deleted:true} soft-delete flag);
    // hard delete is Director-only. Reads stay staff-gated via the academic block above.
    match /{bcdc}/{iddc} {
      allow create: if signedIn() && inBranch(bcdc) && baseOf(bcdc) == 'discipline'
        && (isAny(['admin','vp','office']) || (isAny(['teacher']) && request.resource.data.reportedById == myUsername()));
      allow update: if signedIn() && inBranch(bcdc) && baseOf(bcdc) == 'discipline'
        && (isAny(['admin','vp']) || isCoordinatorRole()
          || (isAny(['teacher'])
            && (resource.data.get('reportedById','') == myUsername() || resource.data.get('assignedToId','') == myUsername()
              || resource.data.get('by','') == myAccountName() || resource.data.get('assignedTo','') == myAccountName())
            && request.resource.data.get('status','open') in ['open','review','action']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actions','status','updatedAt','updatedBy','lastActionAt']))
          || (isAny(['office'])
            && request.resource.data.get('status','open') in ['open','review','action']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentNoticeId','actions','status','updatedAt','updatedBy','lastActionAt'])));
      allow delete: if signedIn() && inBranch(bcdc) && baseOf(bcdc) == 'discipline' && isAny(['admin']);
    }
    // A branch parent/student may only ACKNOWLEDGE a notice — an update touching nothing but readBy/ackAt
    // (mirrors the unprefixed /notices rule; staff writes are covered by the academic block above).
    match /{bcn}/{idn} {
      allow update: if signedIn() && inBranch(bcn) && baseOf(bcn) == 'notices' && isAny(['parent','student'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','ackAt']);
    }
    // Per-branch staff attendance — same server-time anti-spoof guard as Greencity (a SELF check-in must carry serverAt==request.time).
    match /{bcsa}/{idsa} {
      allow read: if signedIn() && inBranch(bcsa) && baseOf(bcsa) == 'staffAttendance';
      allow write: if signedIn() && inBranch(bcsa) && baseOf(bcsa) == 'staffAttendance' && isAny(['admin','vp','teacher','office'])
        && (!('source' in request.resource.data) || request.resource.data.source != 'self' || request.resource.data.serverAt == request.time);
    }
    // Per-branch practice mistakes — any signed-in branch user (incl. students) creates their own; staff manage.
    match /{bcw}/{idw} {
      allow read: if signedIn() && inBranch(bcw) && baseOf(bcw) == 'wrongAnswers';
      allow create: if signedIn() && inBranch(bcw) && baseOf(bcw) == 'wrongAnswers';
      allow update, delete: if signedIn() && inBranch(bcw) && baseOf(bcw) == 'wrongAnswers' && isAny(['admin','vp','teacher']);
    }

    // Academic calendar (per branch) — that branch's staff read; only Director/Principal/VP write.
    match /{bc3}/{id3} {
      allow read:  if signedIn() && inBranch(bc3) && baseOf(bc3) == 'calendar';
      allow write: if signedIn() && inBranch(bc3) && baseOf(bc3) == 'calendar' && isAny(['admin','vp']);
    }

    // ── (6) Everything else: locked ──────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
